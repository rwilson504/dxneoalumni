---
import { Image } from 'astro:assets';
import { formatDate, displayTitle, eventImage, type ChapterEvent } from '~/lib/content';
import { googleMapsDirectionsUrl, isEventPaymentAvailable } from '~/lib/content-utils';

interface Props {
  event: ChapterEvent;
  loading?: 'eager' | 'lazy';
}

const { event, loading = 'lazy' } = Astro.props;
const image = eventImage(event.image_file);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const directionsUrl = event.location ? googleMapsDirectionsUrl(event.location) : null;
const showPayment = event.payment_url
  && isEventPaymentAvailable(event.year, event.month ?? 1, event.day ?? 1);
---

<article class="card">
  {
    image && (
      <div class="card__media">
        <Image
          src={image}
          alt={event.image_alt ?? displayTitle(event)}
          width={520}
          height={390}
          loading={loading}
        />
      </div>
    )
  }
  <div class="card__body">
    <p class="card__date">{formatDate(event.year, event.month, event.day)}</p>
    <h3 class="card__title">{displayTitle(event)}</h3>
    {
      event.location && directionsUrl && (
        <a class="card__location" href={directionsUrl} target="_blank" rel="noreferrer"
          aria-label={`Get directions to ${event.location}`}>
          {event.location}
        </a>
      )
    }
    <p class="card__text">{event.description}</p>
    {
      showPayment && (
        <a class="card__payment" href={event.payment_url!} target="_blank" rel="noreferrer">
          Pay now
        </a>
      )
    }
    {
      event.albumSlug && (
        <a class="card__link" href={`${base}/gallery/${event.albumSlug}`}>
          See the photos &rarr;
        </a>
      )
    }
  </div>
</article>

<style>
  .card__location {
    display: inline-block;
    margin-bottom: 0.65rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .card__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .card__payment {
    display: inline-block;
    margin: 0.75rem 0.85rem 0 0;
    padding: 0.55rem 0.9rem;
    border-radius: 4px;
    background: var(--dx-red-dark);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .card__payment:hover {
    background: var(--dx-red);
    color: #fff;
  }
</style>
