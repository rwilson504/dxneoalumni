---
import { Image } from 'astro:assets';
import { formatDate, displayTitle, eventImage, type ChapterEvent } from '~/lib/content';

interface Props {
  event: ChapterEvent;
  loading?: 'eager' | 'lazy';
}

const { event, loading = 'lazy' } = Astro.props;
const image = eventImage(event.image_file);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="card">
  {
    image && (
      <div class="card__media">
        <Image
          src={image}
          alt={event.image_alt ?? displayTitle(event)}
          width={520}
          height={390}
          loading={loading}
        />
      </div>
    )
  }
  <div class="card__body">
    <p class="card__date">{formatDate(event.year, event.month, event.day)}</p>
    <h3 class="card__title">{displayTitle(event)}</h3>
    <p class="card__text">{event.description}</p>
    {
      event.albumSlug && (
        <a class="card__link" href={`${base}/gallery#${event.albumSlug}`}>
          See the photos &rarr;
        </a>
      )
    }
  </div>
</article>

<style>
  .card__link {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 700;
    font-size: 0.9rem;
  }
</style>
