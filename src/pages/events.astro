---
import BaseLayout from '~/layouts/BaseLayout.astro';
import EventCard from '~/components/EventCard.astro';
import { events, splitByDate, groupByYear } from '~/lib/content';

const { upcoming: upcomingEvents, past: pastEvents } = splitByDate(events);
const pastByYear = groupByYear(pastEvents);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const calendarUrl = new URL(`${base}/events/calendar.ics`, Astro.site).href;
---

<BaseLayout
  title="Events"
  description="Upcoming and past events hosted by the Northeast Ohio Alumni Chapter of The Delta Chi Fraternity."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Events</p>
      <h1>Where the brothers gather</h1>
      <p class="lede">
        Ballgames, breweries, happy hours, service projects, and Founders&rsquo; Day. Since
        2016 we have held {pastEvents.length} gatherings, and counting.
      </p>
      <div class="calendar-actions">
        <button class="btn btn--primary" type="button" data-copy-calendar data-calendar-url={calendarUrl}>
          Copy subscription link
        </button>
        <a class="btn btn--ghost" href={calendarUrl} download="delta-chi-neo-events.ics">
          Download .ics
        </a>
        <span class="copy-status" role="status" aria-live="polite"></span>
      </div>
    </div>
  </section>

  {
    upcomingEvents.length > 0 && (
      <section class="section section--alt" id="upcoming">
        <div class="wrap">
          <h2>Upcoming</h2>
          <div class="grid grid--3">
            {upcomingEvents.map((event) => (
              <EventCard event={event} loading="eager" />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section" id="past">
    <div class="wrap">
      <h2>Past events</h2>
      <nav class="years" aria-label="Jump to year">
        {pastByYear.map(({ year }) => <a href={`#year-${year}`}>{year}</a>)}
      </nav>

      {
        pastByYear.map(({ year, events }) => (
          <section class="year" id={`year-${year}`}>
            <h3 class="year__heading">
              {year}
              <span>{events.length} {events.length === 1 ? 'event' : 'events'}</span>
            </h3>
            <div class="grid grid--3">
              {events.map((event) => (
                <EventCard event={event} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .calendar-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .calendar-actions button {
    border: none;
    cursor: pointer;
  }

  .copy-status {
    align-self: center;
    color: var(--ink-faint);
    font-size: 0.88rem;
  }

  .years {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
  }

  .years a {
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-soft);
    background: var(--surface-alt);
  }

  .years a:hover {
    background: var(--dx-red);
    border-color: var(--dx-red);
    color: #fff;
  }

  .year {
    margin-bottom: 3rem;
    scroll-margin-top: 5rem;
  }

  .year__heading {
    font-size: 1.8rem;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--dx-gold);
    margin-bottom: 1.5rem;
  }

  .year__heading span {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-calendar]');
  const copyStatus = document.querySelector<HTMLElement>('.copy-status');

  copyButton?.addEventListener('click', async () => {
    const url = copyButton.dataset.calendarUrl;
    if (!url) return;

    try {
      await navigator.clipboard.writeText(url);
      if (copyStatus) copyStatus.textContent = 'Link copied.';
    } catch {
      if (copyStatus) copyStatus.textContent = 'Could not copy the link.';
    }
  });
</script>
