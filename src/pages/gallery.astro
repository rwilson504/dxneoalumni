---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { albums, formatDate, galleryImage } from '~/lib/content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Albums arrive newest first. Use the first available image as the cover and drop an
// album rather than rendering a broken card when none of its files are in the repo.
const sections = albums
  .map((album) => ({
    ...album,
    // Most titles already carry their year ("Holiday Get Together 2025"); repeating it
    // beside them just reads as "2025 2025".
    dateLabel:
      album.year && !album.title.includes(String(album.year))
        ? formatDate(album.year, album.month)
        : '',
    cover: album.photos.map((photo) => galleryImage(photo.file)).find(Boolean),
  }))
  .filter((album) => album.cover);

const total = albums.reduce((count, album) => count + album.photos.length, 0);
---

<BaseLayout
  title="Photo Gallery"
  description="Photos from events hosted by the Northeast Ohio Alumni Chapter of The Delta Chi Fraternity."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>Photos</h1>
      <p class="lede">
        Moments from ballgames, breweries, service projects, and Founders&rsquo; Day dinners across
        Northeast Ohio: {total} photos across {sections.length} events, newest first.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <ul class="albums">
        {
          sections.map((album, index) => (
            <li id={album.slug}>
              <a href={`${base}/gallery/${album.slug}`}>
                <Image
                  src={album.cover!}
                  alt=""
                  width={520}
                  height={390}
                  loading={index < 6 ? 'eager' : 'lazy'}
                />
                <span class="album__body">
                  <strong>{album.title}</strong>
                  <span>
                    {album.dateLabel && <span>{album.dateLabel} &middot; </span>}
                    {album.photos.length} {album.photos.length === 1 ? 'photo' : 'photos'}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.25rem;
  }

  .albums li {
    min-width: 0;
    scroll-margin-top: 5rem;
  }

  .albums a {
    display: block;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }

  .albums a:hover {
    color: var(--ink);
    border-color: var(--dx-red);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .albums img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .album__body {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 1rem 1rem;
  }

  .album__body strong {
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .album__body > span {
    color: var(--ink-faint);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>
