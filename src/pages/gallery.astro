---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import galleryData from '~/data/gallery.json';

type GalleryPhoto = {
  file: string;
  /** Verbatim caption from the Wix site, e.g. "Cleveland Whiskey Tour (2)". */
  caption: string;
  group: string | null;
  groupIndex: number | null;
};

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpg,jpeg,png,gif}',
  { eager: true }
);

const photos = (galleryData as GalleryPhoto[])
  .map((photo) => ({
    ...photo,
    image: images[`/src/assets/gallery/${photo.file}`]?.default,
  }))
  .filter((photo) => photo.image);
---

<BaseLayout
  title="Photo Gallery"
  description="Photos from events hosted by the Northeast Ohio Alumni Chapter of The Delta Chi Fraternity."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>Photos</h1>
      <p class="lede">
        Moments from ballgames, breweries, service projects, and Founder&rsquo;s Day dinners across
        Northeast Ohio.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="masonry">
        {
          photos.map((photo, index) => (
            <figure>
              <Image
                src={photo.image!}
                alt={photo.caption}
                width={640}
                loading={index < 4 ? 'eager' : 'lazy'}
              />
              <figcaption>{photo.group ?? photo.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .masonry {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 620px) {
    .masonry {
      columns: 2;
    }
  }

  @media (min-width: 960px) {
    .masonry {
      columns: 3;
    }
  }

  figure {
    margin: 0 0 1rem;
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--surface);
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    padding: 0.6rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink-faint);
  }
</style>
