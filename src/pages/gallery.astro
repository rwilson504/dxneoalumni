---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { albums, formatDate, galleryImage } from '~/lib/content';

// Albums arrive newest first; a photo whose file is missing from the repo is dropped
// rather than rendered as a broken tile.
const sections = albums
  .map((album) => ({
    ...album,
    // Most titles already carry their year ("Holiday Get Together 2025"); repeating it
    // beside them just reads as "2025 2025".
    dateLabel:
      album.year && !album.title.includes(String(album.year))
        ? formatDate(album.year, album.month)
        : '',
    photos: album.photos
      .map((photo) => ({ ...photo, image: galleryImage(photo.file) }))
      .filter((photo) => photo.image),
  }))
  .filter((album) => album.photos.length > 0);

const total = sections.reduce((n, album) => n + album.photos.length, 0);
let rendered = 0;
---

<BaseLayout
  title="Photo Gallery"
  description="Photos from events hosted by the Northeast Ohio Alumni Chapter of The Delta Chi Fraternity."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Gallery</p>
      <h1>Photos</h1>
      <p class="lede">
        Moments from ballgames, breweries, service projects, and Founder&rsquo;s Day dinners across
        Northeast Ohio &mdash; {total} photos across {sections.length} events, newest first.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      {
        sections.map((album) => (
          <section class="album" id={album.slug}>
            <h2 class="album__heading">
              {album.title}
              {album.dateLabel && <span>{album.dateLabel}</span>}
            </h2>
            <div class="tiles">
              {album.photos.map((photo) => {
                rendered++;
                return (
                  <figure>
                    <Image
                      src={photo.image!}
                      alt={photo.caption ?? album.title}
                      width={520}
                      height={390}
                      loading={rendered <= 6 ? 'eager' : 'lazy'}
                    />
                  </figure>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .album {
    margin-bottom: 2rem;
    /* Linked to from event cards, so keep the heading clear of the sticky header. */
    scroll-margin-top: 5rem;
  }

  .album__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    margin: 0 0 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--rule);
  }

  .album__heading span {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* A uniform grid rather than CSS columns: 30 of the albums hold a single photo, and
     columns would leave two thirds of their row blank. */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
  }

  figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--surface);
  }

  figure img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
</style>
