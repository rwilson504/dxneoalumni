---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import awards from '~/data/awards.json';
import shield from '~/assets/dx-shield-gold.png';

type AwardYear = { period: string; awards: string[] };
const timeline = awards as AwardYear[];
const total = timeline.reduce((sum, entry) => sum + entry.awards.length, 0);
const cupYears = timeline.filter((e) => e.awards.some((a) => a.startsWith('Chicago Cup')));
---

<BaseLayout
  title="Awards"
  description="Awards earned by the Northeast Ohio Alumni Chapter of The Delta Chi Fraternity, including the Chicago Cup."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Recognition</p>
      <h1>Chapter awards</h1>
      <p class="lede">
        {total} awards from The Delta Chi Fraternity since the chapter was re-chartered, including
        three Chicago Cups, the highest honor an alumni chapter can earn.
      </p>
    </div>
  </section>

  <section class="section cups">
    <div class="wrap">
      <p class="eyebrow">The highest honor an alumni chapter can earn</p>
      <ul class="cup-grid">
        {
          cupYears.map((entry) => (
            <li class="cup">
              <Image class="cup__mark" src={shield} alt="" width={96} height={103} />
              <p class="cup__name">Chicago Cup</p>
              <p class="cup__year">{entry.period}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <ol class="timeline">
        {
          timeline.map((entry) => (
            <li>
              <h2>{entry.period}</h2>
              <ul>
                {entry.awards.map((award) => (
                  <li class={award.startsWith('Chicago Cup') ? 'is-cup' : ''}>{award}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* Sits directly under the lede, so it drops its own top padding rather than stacking. */
  .cups {
    padding-top: 0;
    padding-bottom: 3rem;
  }

  .cup-grid {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    max-width: 58rem;
  }

  .cup {
    background: var(--dx-red);
    color: #fff;
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem 1.25rem;
    text-align: center;
  }

  .cup__mark {
    width: 60px;
    height: auto;
    margin: 0 auto 0.75rem;
    display: block;
  }

  .cup__name {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .cup__year {
    margin: 0.2rem 0 0;
    color: var(--dx-gold);
    font-weight: 700;
    font-size: 1.05rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
    border-left: 3px solid var(--rule);
    display: grid;
    gap: 2rem;
    max-width: 58rem;
  }

  .timeline > li {
    position: relative;
  }

  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 9px);
    top: 0.55rem;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--dx-red);
    border: 3px solid var(--surface-alt);
  }

  .timeline h2 {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }

  .timeline ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .timeline ul li {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 0.55rem 0.95rem;
    font-size: 0.95rem;
  }

  .timeline ul li.is-cup {
    border-color: var(--dx-gold);
    background: var(--dx-gold-soft);
    font-weight: 600;
  }

  @media (max-width: 680px) {
    .timeline ul {
      grid-template-columns: 1fr;
    }
  }
</style>
