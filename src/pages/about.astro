---
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/data/site';
import { currentDuesRate } from '~/lib/content';
import founders from '~/assets/gallery/f002fe_6cc2358307c3457b8de502da8caeeaf9-mv2.jpg';
import friendship from '~/assets/value-friendship.png';
import character from '~/assets/value-character.png';
import justice from '~/assets/value-justice.png';
import education from '~/assets/value-education.png';

const values = [
  { icon: friendship, label: 'Friendship' },
  { icon: character, label: 'Character' },
  { icon: justice, label: 'Justice' },
  { icon: education, label: 'Education' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="About Us"
  description="The history, structure, and benefits of the Northeast Ohio Alumni Chapter of The Delta Chi Fraternity."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">About us</p>
      <h1>Brotherhood that outlasts the chapter house</h1>
      <p class="lede">
        The Northeast Ohio Alumni Chapter of The Delta Chi Fraternity was formed for alumni from all
        Delta Chi chapters living in the Northeast Ohio area, to gather at events to celebrate
        brotherhood and social justice through philanthropic events.
      </p>
    </div>
  </section>

  <section class="section values">
    <div class="wrap">
      <p class="eyebrow eyebrow--on-dark">What Delta Chi stands for</p>
      <ul class="values-grid">
        {
          values.map((value) => (
            <li class="value">
              <Image src={value.icon} alt="" aria-hidden="true" width={72} height={72} />
              <p>{value.label}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="history">
        <div class="prose narrow">
          <h2>The history</h2>
          <p>
            The Alumni Chapter started back in the early 2000&rsquo;s and ran for a few years, but was
            closed. In 2016 a group of dedicated alumni felt the Alumni Chapter needed to be reformed.
            On October 13, 2016, a large group of Brothers gathered at Harry&rsquo;s Steakhouse in
            Independence, Ohio, the same location where the original chapter formed. They signed the
            petition to charter the Northeast Ohio Alumni Chapter. On {site.charteredOn}, the Delta Chi
            Board of Regents approved the charter of the current Alumni Chapter.
          </p>
        </div>

        <figure class="history__figure">
          <Image src={founders} alt="Brothers gathered at the 2016 chartering dinner" width={1400} height={686} />
          <figcaption>Some of the Brothers who rechartered the chapter, 2016.</figcaption>
        </figure>

        <div class="prose narrow">
          <h2>Structure</h2>
          <p>
            The Alumni Chapter is set up as a separate 501(c)(7) entity affiliated with the
            International Delta Chi Fraternity, in the same way as an Undergraduate Chapter. We are
            responsible for all our own tax filings and are <strong>not</strong> tax exempt in the same
            way an Undergraduate Chapter is. Read our <a href={`${base}/by-laws`}>chapter by-laws</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What are the benefits of joining?</h2>
      <div class="grid grid--2 benefit-grid">
        <div class="benefit">
          <h3>Promote friendship</h3>
          <ul>
            <li>Reconnect with Brothers you went to school with</li>
            <li>Provide a welcoming environment for Brothers new to Northeast Ohio</li>
            <li>Meet Brothers from other Undergraduate Chapters who live in the area</li>
          </ul>
        </div>
        <div class="benefit">
          <h3>Develop character</h3>
          <ul>
            <li>Give back to others by participating in philanthropic events</li>
            <li>Provide leadership for Undergraduate Chapters</li>
          </ul>
        </div>
        <div class="benefit">
          <h3>Networking opportunities</h3>
          <ul>
            <li>Assist other Delta Chi alumni with potential job opportunities</li>
            <li>Join a network of professionals that can help you find a new role</li>
          </ul>
        </div>
        <div class="benefit">
          <h3>Mentorship</h3>
          <ul>
            <li>Give back by providing support to Undergraduate Chapters</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="prose narrow">
        <h2>What does my ${currentDuesRate.chapterAmount} membership get me?</h2>
        <p>
          Virtual membership is ${currentDuesRate.virtualAmount}. We invest most of our dues directly back into our
          membership:
        </p>
        <ul>
          <li>
            <strong>Discounted tickets to events.</strong> On top of the group rates we negotiate, we
            use dues to further reduce what members pay to attend.
          </li>
          <li>
            <strong>Food at events.</strong> Dues cover appetizers or discounted food at some events,
            including most Happy Hours.
          </li>
          <li>
            <strong>Planned speaker programs.</strong> Our recruitment plans include speakers on
            professional and personal growth, such as financial consultants and career counselors.
          </li>
          <li>
            <strong>Founders&rsquo; Day.</strong> Each year the chapter coordinates a Founders&rsquo;
            Day event to bring Brothers together on our &ldquo;birthday.&rdquo;
          </li>
          <li>
            <strong>Alumni Rededication Ceremonies.</strong> We work with Undergraduate Chapters to
            facilitate rededications for graduating seniors and alumni who haven&rsquo;t yet taken
            part.
          </li>
          <li>
            <strong>The Convention bus tour.</strong> Dues provide working capital for this
            &ldquo;must do&rdquo; activity at the Delta Chi International Convention.
          </li>
          <li>
            <strong>IHQ dues.</strong> Like Undergraduate Chapters, Alumni Chapters pay International
            Headquarters dues. In return, IHQ provides alumni contact data, money management software,
            and other resources.
          </li>
          <li>
            <strong>Operating expenses.</strong> Postage, website, outreach, and communications.
          </li>
        </ul>

        <a class="btn btn--primary" href={site.duesUrl} rel="noopener noreferrer" target="_blank">
          Join for ${currentDuesRate.chapterAmount}/year
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow {
    max-width: 68ch;
  }

  /* Gold on cream washes out, so the official value marks get a charcoal ground. */
  .values {
    background: #16161a;
    color: #fff;
    padding-block: 2.75rem;
  }

  .eyebrow--on-dark {
    color: var(--dx-gold);
  }

  .values-grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.75rem 1rem;
  }

  .value {
    text-align: center;
  }

  .value img {
    width: 60px;
    height: auto;
    margin: 0 auto 0.7rem;
    display: block;
  }

  .value p {
    margin: 0;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dx-gold);
  }

  .history {
    display: grid;
    gap: 2rem;
  }

  /* The photo is a 2:1 panorama, so it runs full width rather than being cropped square. */
  .history__figure {
    margin: 0;
  }

  .history__figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }

  .history__figure figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted, #6b6b6b);
  }

  .benefit-grid {
    margin-top: 1.75rem;
  }

  .benefit {
    background: var(--surface-alt);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--dx-red);
    border-radius: var(--radius);
    padding: 1.25rem 1.4rem 1rem;
  }

  .benefit h3 {
    margin-top: 0;
  }

  .benefit ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .benefit li {
    margin-bottom: 0.35rem;
  }
</style>
