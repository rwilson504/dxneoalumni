# Supabase connection for the member area.
# Copy to .env and fill in from your Supabase project: Settings -> API.
#
# Both values are PUBLIC by design — they ship in the browser bundle. The anon key
# identifies the project; it grants no access on its own. Row Level Security decides
# what a signed-in browser can read or write.
#
# NEVER put the service_role key here. It bypasses RLS entirely.

PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
